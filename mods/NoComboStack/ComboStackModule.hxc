import funkin.modding.events.ScriptEvent;
import funkin.modding.module.Module;
import funkin.play.PlayState;

/**
 * A module that deletes previous comboPopUps
 * sprites whenever a note is hit.
 *
 * @author RagdollClash
 */
class ComboStackModule extends Module
{
  function new():Void
  {
    super("ComboStackModule", {state: PlayState});
  }

  override function onNoteHit(event:HitNoteScriptEvent):Void
  {
    super.onNoteHit(event);

    if (PlayState.instance == null || !event.note.noteData.getMustHitNote())
      return;

    for (member in PlayState.instance.comboPopUps.members)
      member.destroy();
  }
}
