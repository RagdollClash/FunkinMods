import funkin.data.notestyle.NoteStyleRegistry;
import funkin.graphics.FunkinSprite;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.play.notes.notestyle.NoteStyle;

/**
 * A module that colors the combo popup sprites
 * according to the judgement that you were given.
 *
 * @author RagdollClash
 */
class ResultsComboModule extends Module
{
  final RATING_COLORS:Map<String, Int> = [
    "sick" => 0xFF89E59E,
    "good" => 0xFF89C9E5,
    "bad" => 0xFFE6CF8A,
    "shit" => 0xFFE68C8A
  ];

  function new():Void
  {
    super("ResultsComboModule", {state: PlayState});
  }

  var judgement:String = '';
  var comboKeys:Array<String> = [];

  override function onStateChangeEnd(event:StateChangeScriptEvent):Void
  {
    super.onStateChangeEnd(event);

    judgement = '';
    comboKeys.resize(0);

    if (event.targetState is PlayState)
    {
      var noteStyleId:String = PlayState.instance.comboPopUps.noteStyle.id;
      var noteStyle:Null<NoteStyle> = NoteStyleRegistry.instance.fetchEntry(noteStyleId + '-rsc');
      if (noteStyle != null)
      {
        PlayState.instance.comboPopUps.noteStyle = noteStyle;
        PlayState.instance.comboPopUps.memberAdded.add(onPopUpMemberAdded);
        for (i in 0...10) comboKeys.push(Paths.image(noteStyle.buildComboNumSpritePath(i)));
      }
    }
  }

  override function onNoteHit(event:HitNoteScriptEvent):Void
  {
    super.onNoteHit(event);
    if (event.note.noteData.getMustHitNote()) judgement = event.judgement;
  }

  override function onNoteMiss(event:NoteScriptEvent):Void
  {
    super.onNoteMiss(event);
    judgement = 'miss';
  }

  function onPopUpMemberAdded(member:FunkinSprite):Void
  {
    if (comboKeys.contains(member.graphic.key))
      member.color = RATING_COLORS.exists(judgement) ? RATING_COLORS.get(judgement) : 0xFFFFFFFF;
  }
}
